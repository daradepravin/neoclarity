# Copy this file to `.env` and edit values for local development.
# Do NOT commit `.env` with real secrets.

# A strong JWT secret is required for production. For local development you can keep
# a simple value, but replace it before deploying.
JWT_SECRET=dev-only-change-me-this-must-be-at-least-256-bits-long-for-hs256

# URL for the agent layer if you run an agent service locally. Using host.docker.internal
# allows the container to reach a host service on Windows/macOS. Adjust for Linux Docker setups.
AGENT_BASE_URL=http://host.docker.internal:8000

# Example: override DB values if you need to point to a different DB
# DB_URL=jdbc:postgresql://postgres:5432/neoclarity
# DB_USERNAME=neoclarity
# DB_PASSWORD=neoclarity_dev

