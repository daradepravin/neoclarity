# NeoClarity Agent Layer — environment variables
# Copy to .env and fill in your values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Neo4j AuraDB (get from console.neo4j.io)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password

# Optional overrides
# PORT=8000
# DEBUG=false
# CLAUDE_MODEL=claude-sonnet-4-6

# Shared secret between Spring Boot and this agent layer.
# Leave empty for local dev; set to a strong random value in production.
# Spring Boot must send the same value as AGENT_SHARED_SECRET.
AGENT_SHARED_SECRET=
